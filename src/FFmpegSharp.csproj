<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1;</TargetFrameworks> 
        <PackageId>FFmpeg4Sharp</PackageId>
        <Description>
            A FFmpeg.AutoGen Warpper Library.
        </Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>FFmpeg</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/IOL0ol1/EmguFFmpeg/tree/dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/IOL0ol1/EmguFFmpeg/tree/dev</RepositoryUrl>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>ffmpeg media video audio capture encode decode encoding decoding codec ffmpegmanaged ffmpegcsharp ffmpegnet ffmpeg4sharp FFmpeg.Sharp</PackageTags>
        <RepositoryType>git</RepositoryType>
        <Version>8.0.0</Version>
        <NoWarn>1701;1702;1591</NoWarn>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
        <PackageReference Include="System.Memory" Version="4.5.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" Visible="false" PackagePath="\" />
        <None Include="../icon.png" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

</Project>
